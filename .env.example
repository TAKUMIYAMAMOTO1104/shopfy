# Shopify Admin API認証情報
# ShopifyパートナーダッシュボードまたはストアのAdmin > Apps > 非公開アプリから取得してください

# SHOPIFY_SHOP_NAME または SHOPIFY_STORE のどちらでも使えます
SHOPIFY_SHOP_NAME=your-shop-name        # 例: mystore (mystore.myshopify.com の場合)
# SHOPIFY_STORE=your-shop-name          # 別名

# SHOPIFY_ACCESS_TOKEN または SHOPIFY_TOKEN のどちらでも使えます
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxx  # Admin APIアクセストークン
# SHOPIFY_TOKEN=shpat_xxxxxxxxxxxx       # 別名

SHOPIFY_LOCATION_ID=                    # 省略可。省略時は最初のロケーションを自動使用

# ================================================================== #
# Claude AI連携 (ai-generate / optimize-price --ai / report --ai-summary)
# https://console.anthropic.com でAPIキーを取得してください
# ================================================================== #
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx

# ================================================================== #
# スケジューラー設定 (schedule --start)
# ================================================================== #
SCHEDULE_REPORT_HOUR=9                  # 毎日レポート生成する時刻 (0-23)
SCHEDULE_OPTIMIZE_DAY=monday            # 価格最適化を実行する曜日
SCHEDULE_REPORT_OUTPUT=reports/         # レポートCSVの出力ディレクトリ
SCHEDULE_AI_SUMMARY=true                # レポートにAIサマリーを付与するか
SCHEDULE_LOW_STOCK_THRESHOLD=5          # 低在庫アラート閾値
SCHEDULE_HIGH_STOCK_THRESHOLD=50        # 高在庫アラート閾値
SCHEDULE_LOW_STOCK_MARKUP=0.10          # 低在庫時の値上げ率 (10%)
SCHEDULE_HIGH_STOCK_DISCOUNT=0.10       # 高在庫時の値下げ率 (10%)
SCHEDULE_AI_PRICE=false                 # 価格最適化にAIを使うか (trueにするとClaude API使用)
