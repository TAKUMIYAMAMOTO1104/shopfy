# Shopify Admin API認証情報
# ShopifyパートナーダッシュボードまたはストアのAdmin > Apps > 非公開アプリから取得してください

# SHOPIFY_SHOP_NAME または SHOPIFY_STORE のどちらでも使えます
SHOPIFY_SHOP_NAME=your-shop-name        # 例: mystore (mystore.myshopify.com の場合)
# SHOPIFY_STORE=your-shop-name          # 別名

# SHOPIFY_ACCESS_TOKEN または SHOPIFY_TOKEN のどちらでも使えます
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxx  # Admin APIアクセストークン
# SHOPIFY_TOKEN=shpat_xxxxxxxxxxxx       # 別名

SHOPIFY_LOCATION_ID=                    # 省略可。省略時は最初のロケーションを自動使用

# ---------------------------------------------------------------
# LINE Messaging API 認証情報
# LINE Developers コンソール > Messaging API チャネル > チャネルアクセストークン
# から「長期のチャネルアクセストークン」を発行して貼り付けてください。
# ---------------------------------------------------------------
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token-here
