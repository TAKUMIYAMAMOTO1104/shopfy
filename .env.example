# ================================================================== #
# Shopify Admin API認証情報
# ================================================================== #
SHOPIFY_SHOP_NAME=your-shop-name          # 例: xm-2031
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxx   # Admin APIアクセストークン
SHOPIFY_STORE_URL=https://xm-2031.myshopify.com  # 商品URLリンク生成用

# ================================================================== #
# Claude AI (商品説明生成・SNS投稿文・KPI分析)
# https://console.anthropic.com
# ================================================================== #
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx

# ================================================================== #
# X(Twitter) API (SNS自動投稿)
# https://developer.twitter.com でアプリ作成・Read+Write権限必須
# ================================================================== #
X_API_KEY=xxxxxxxxxxxx
X_API_SECRET=xxxxxxxxxxxx
X_ACCESS_TOKEN=xxxxxxxxxxxx
X_ACCESS_TOKEN_SECRET=xxxxxxxxxxxx

# ================================================================== #
# スケジューラー設定 (schedule --start)
# ================================================================== #
SCHEDULE_REPORT_HOUR=9              # 毎日レポート生成時刻 (0-23)
SCHEDULE_SNS_HOUR=12                # 毎日SNS投稿時刻 (0-23)
SCHEDULE_OPTIMIZE_DAY=monday        # 価格最適化曜日
SCHEDULE_REPORT_OUTPUT=reports/     # レポートCSV出力ディレクトリ
SCHEDULE_AI_SUMMARY=true            # レポートにAIサマリーを付与するか
SCHEDULE_LOW_STOCK_THRESHOLD=5      # 低在庫アラート閾値
SCHEDULE_HIGH_STOCK_THRESHOLD=50    # 高在庫アラート閾値
SCHEDULE_LOW_STOCK_MARKUP=0.10      # 低在庫時の値上げ率 (10%)
SCHEDULE_HIGH_STOCK_DISCOUNT=0.10   # 高在庫時の値下げ率 (10%)
SCHEDULE_AI_PRICE=false             # 価格最適化にAIを使うか
SCHEDULE_GEN_PRODUCT_BATCH=1        # 毎日自動生成する商品数
SCHEDULE_GEN_PRODUCT_TYPE=prompt_pack  # 自動生成する商品タイプ
